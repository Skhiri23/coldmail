# Copie ce fichier en ".env" et remplis tes vraies valeurs. Ne partage jamais ton .env.

# --- Compte email utilisé pour envoyer les candidatures ---
# Gmail : utilise un "mot de passe d'application" (pas ton mot de passe normal)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Informations affichées dans la signature du mail ---
SENDER_NAME=Mohamed Aziz Skhiri
SENDER_EMAIL=ton.email@gmail.com
SENDER_PHONE=+216 52 237 532
LINKEDIN_URL=linkedin.com/in/mohamed-aziz-skhiri-498627254
PORTFOLIO_URL=skhiri23.github.io

# --- Chemin vers ton CV (PDF) ---
CV_PATH=cv/CV.pdf

# --- Optionnel : clé API Anthropic pour générer une lettre plus variée ---
# Si laissé vide, un template pré-écrit est utilisé (fonctionne sans clé).
ANTHROPIC_API_KEY=
